<Project Sdk="Microsoft.NET.Sdk">
  <!-- Infrastructure: adapters that implement Application's ports with real files and programs.
       Each pinned outside program (see the README's reference environment) gets its adapter here,
       so swapping that program later touches this layer only. -->
  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- The source-generated calls into the system (OpenedFile) need it. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Nst.Application/Nst.Application.csproj" />
    <InternalsVisibleTo Include="Nst.Tests" />
  </ItemGroup>
</Project>
