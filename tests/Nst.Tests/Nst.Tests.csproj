<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runtime checks of nst. Process tests run the built nst the way a session calls it; layer tests run
       Application in process; architecture tests read the built assemblies. Lean proves rules on a model;
       these tests hold the real program to the same rules. The judge slot (Judging/) lives here, not in nst. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit.v3" Version="4.0.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/nst/nst.csproj" />
    <ProjectReference Include="../../src/Nst.Domain/Nst.Domain.csproj" />
    <ProjectReference Include="../../src/Nst.Application/Nst.Application.csproj" />
    <ProjectReference Include="../../src/Nst.Infrastructure/Nst.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
